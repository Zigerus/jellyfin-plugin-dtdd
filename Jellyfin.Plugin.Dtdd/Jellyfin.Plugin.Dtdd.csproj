<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build target selector. One source, two artifacts — never one DLL for
         both runtimes (Jellyfin 12 moved to .NET 10 and changed plugin
         interfaces, so a 10.11 build is not loadable on 12 and vice versa):
           JellyfinTarget=jf12 -> Jellyfin 12.x,   net10.0 (default)
           JellyfinTarget=jf10 -> Jellyfin 10.11.x, net9.0
         Select with `dotnet build -p:JellyfinTarget=jf10`. Each target
         restores its own assets, so do not pass -\-no-restore when switching
         targets in one tree. Same pattern as JavaScript Injector 4.0. -->
    <JellyfinTarget Condition="'$(JellyfinTarget)' == ''">jf12</JellyfinTarget>
    <RootNamespace>Jellyfin.Plugin.Dtdd</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(JellyfinTarget)' == 'jf12'">
    <TargetFramework>net10.0</TargetFramework>
    <JellyfinVersion>12.0.0</JellyfinVersion>
    <JellyfinTargetAbi>12.0.0.0</JellyfinTargetAbi>
    <MicrosoftDataSqliteVersion>10.0.11</MicrosoftDataSqliteVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(JellyfinTarget)' == 'jf10'">
    <TargetFramework>net9.0</TargetFramework>
    <JellyfinVersion>10.11.0</JellyfinVersion>
    <JellyfinTargetAbi>10.11.0.0</JellyfinTargetAbi>
    <MicrosoftDataSqliteVersion>9.0.10</MicrosoftDataSqliteVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the ABI FLOOR (10.11.0), not to the host's version.
         .NET assembly binding lets a newer host satisfy a lower reference, so a
         10.11.0-referencing build loads on every 10.11.x server; the reverse
         fails, which is what the old wildcard (10.11.*-*) did when it resolved
         to 10.11.9 against a 10.11.8 host.

         Do NOT "bump in lockstep with the deployment" — that was the previous
         rule here and it was wrong. build.yaml/manifest.json declare
         targetAbi 10.11.0.0, and Jellyfin's compatibility test is
         `_appVersion >= targetAbi` (Emby.Server.Implementations/Plugins/
         PluginManager.cs), so the catalog offers this plugin to every 10.11.x
         server. Pinning above the floor ships an artifact that cannot load on
         the lower half of its own declared range: the previous 10.11.8 pin was
         broken for 10.11.0-10.11.7. Keep JellyfinVersion (above, per target)
         equal to that target's ABI floor: 10.11.0 for jf10, 12.0.0 for jf12. -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Not shipped in the zip: resolves from the host at runtime, so track the
         host's EF Core line per target (EF Core 9 on 10.11, EF Core 10 on 12). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="$(MicrosoftDataSqliteVersion)" />
    <!-- Newtonsoft.Json is required ONLY for the JS Injector reflection contract
         (its PluginInterface.RegisterScript accepts a JObject). System.Text.Json
         is used everywhere else. Pinned to 13.0.1 to match JS Injector's pin so
         a single Newtonsoft.Json assembly version is loaded at runtime. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Web\dtdd-injector.js" />
    <EmbeddedResource Include="Web\dtdd-injector.js" />
  </ItemGroup>

</Project>

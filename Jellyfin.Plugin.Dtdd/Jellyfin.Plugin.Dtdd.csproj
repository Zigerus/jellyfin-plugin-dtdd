<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Dtdd</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to 10.11.8 — the version the production Servarr container is running
         (lscr.io/linuxserver/jellyfin:latest at the time of v1 development).
         The wildcard 10.11.*-* resolves to whatever's newest on NuGet, which
         caused a "Could not load assembly MediaBrowser.Common 10.11.9.0" load
         failure on the 10.11.8 host. Bump this in lockstep with the deployment
         when the container upgrades. -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.8">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.8">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.10" />
    <!-- Newtonsoft.Json is required ONLY for the JS Injector reflection contract
         (its PluginInterface.RegisterScript accepts a JObject). System.Text.Json
         is used everywhere else. Pinned to 13.0.1 to match JS Injector's pin so
         a single Newtonsoft.Json assembly version is loaded at runtime. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Web\dtdd-injector.js" />
    <EmbeddedResource Include="Web\dtdd-injector.js" />
  </ItemGroup>

</Project>
